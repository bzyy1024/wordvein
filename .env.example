# =============================================================
# 环境变量样例 —— 复制为 .env 后按实际情况填写
#   cp .env.example .env
# 注意：.env 已在 .gitignore 与 .dockerignore 中，切勿提交、也不会进镜像
# =============================================================

# =============================================================
# 数据库（外部实例，compose 不部署数据库容器）
# =============================================================
# 唯一来源：Web 容器与宿主机脚本（db:init / import）共用这一条。
# host / port / user / password 都写在串里，无需拆成多个变量。
#
# 两个坑：
#   1. 密码含 @ : / # ? & 等字符时必须 URL 编码，例：p@ss → p%40ss
#      编码命令：[uri]::EscapeDataString('p@ss')
#   2. 云 RDS / 远程库通常要求 SSL，末尾追加 ?sslmode=require
#      完整示例：postgresql://app:xxx@host:5432/roots?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 目标 schema，缺省 public。
# 场景：外部托管库里普通账号通常无 public 的 CREATE 权限（PG15+ 起已收回默认授权），
#      此时设为自建 schema 名（如 wordvein），db:init 会自动创建并授权给当前账号。
# 三条链路（运行时 / 建表 / 导入）共用本变量，口径统一。
# DB_SCHEMA=public

# -------------------- 站点地址 --------------------
# 对外访问地址，用于 sitemap.xml / robots.txt / canonical。
# 运行时读取，换域名改这里重启容器即可，不需要重新构建镜像。
# 注意不要用 NEXT_PUBLIC_SITE_URL：那类变量会被构建时内联，
# 镜像构建期读不到 .env，sitemap 里的地址会一直是 http://localhost:3000
SITE_URL=http://localhost:3000

# -------------------- 应用 --------------------
NODE_ENV=production
# 容器内端口固定 3000，此变量仅宿主机 next dev 使用
PORT=3000
# 宿主机 -> 容器 3000 的映射端口（站点）
WEB_PORT=3000

# -------------------- 邮件（SMTP）--------------------
# 阿里云邮件推送。用于发送邮箱登录 / 注册链接（第三期）。
# 这些变量在服务端读取（非 NEXT_PUBLIC_），改完重启容器即可，无需重建镜像；
# 容器内使用需在 docker-compose.yml 的 environment 段显式注入（web 服务已注入）。
# 未配置时：开发环境把登录链接打印到控制台并回给前端；生产环境直接报错，不发信。
SMTP_HOST=smtpdm.aliyun.com
# 465 = 隐式 TLS（SMTPS，连接即加密）；587 = STARTTLS（先明文再升级）。阿里云两者都支持
SMTP_PORT=465
SMTP_USER=
# 阿里云控制台单独设置的 SMTP 密码，不是邮箱登录密码
SMTP_PASSWORD=
# 发件地址，需与控制台配置的发信地址一致，否则会被拒发
SMTP_FROM=

# -------------------- 用户账号（邮箱登录链接）--------------------
# 签发登录会话 JWT 的密钥，必填。改它会让所有已登录用户失效（下线），属于安全兜底手段。
# 生成：openssl rand -hex 32  或  [guid]::NewGuid().ToString('N') + 随机串
AUTH_JWT_SECRET=
# 会话有效期（天），缺省 7（一周）。上限 90 天，非法值按 7 天处理
AUTH_SESSION_DAYS=7
# 邮件里登录链接使用的域名。场景：站点域名与对外发信地址不同（如内网部署）时单独指定。
# 缺省回退 SITE_URL。结尾不要带斜杠，示例：https://wordvein.example.com
# AUTH_URL=
# 会话 Cookie 是否加 Secure：缺省时 AUTH_URL / SITE_URL 为 https 会自动带上。
# 走 http 内网访问时必须显式设为 0，否则浏览器不下发 Cookie，表现为"登录不上"
AUTH_COOKIE_SECURE=0

# -------------------- 管理端 --------------------
# 管理端独立端口，建议只对本机 / 内网开放
ADMIN_PORT=8311
# 管理口令，必填；未设置时管理端拒绝登录。
# 生成强口令：[System.Web.Security.Membership]::GeneratePassword(24,4)
ADMIN_PASSWORD=change-me-please
# 管理端走 HTTPS 时设为 1，给会话 Cookie 加 Secure；内网 http 保持 0
ADMIN_COOKIE_SECURE=0
